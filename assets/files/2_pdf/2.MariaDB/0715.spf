			<string>/* SELECT @@autocommit */
SET autocommit = 0;

CREATE TABLE DEPTCOPY AS
SELECT * FROM DEPT;


-- 데이터 1개 삽입
INSERT INTO DEPTCOPY VALUES('50',  '영업', '제주');

-- 현재 상태를 확인: 현재 데이터가 5개
SELECT * FROM DEPTCOPY;

-- 작업 취소
ROLLBACK;


--  현재 상태 확이니 현재 데이터가 4개( 삽입 작업 한 내역이 사라짐)
SELECT *
FROM DEPTCOPY;

-- 데이터 1개 삭제
DELETE FROM DEPTCOPY WHERE DEPTNO = 10;

-- 현재 상태 확인
SELECT * FROM DEPTCOPY;

COMMIT;
ROLLBACK;

-- 현재 상태를 확이니 현재 데이터가 3개(COMMIT을 하게 되면 작업 내용은 원본에 반영되어 복제를 다시 해옴)
-- commit을 수행하게 되면 기존 작업내역을 삭제함
SELECT * FROM DEPTCOPY;


DELETE FROM DEPTCOPY WHERE DEPTNO = 20;
CREATE TABLE DEPTSNAPSHOT AS
SELECT * FROM DEPTCOPY;

ROLLBACK;

SELECT*
FROM DEPTCOPY;


-- 
SAVEPOINT s;
DELETE FROM DEPTCOPY WHERE DEPTNO = 40;

SELECT * FROM DEPTCOPY;

ROLLBACK to s;

</string>
